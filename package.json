{
  "name": "applets",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check packages",
    "test": "vp run -r test",
    "dev": "node packages/cli/src/index.ts dev",
    "dev:remote": "vp run -F @applets/editor dev",
    "deploy": "node packages/cli/src/index.ts deploy",
    "destroy": "node packages/cli/src/index.ts destroy",
    "push": "node packages/cli/src/index.ts push",
    "push:local": "APPLET_HOST_SUFFIX=.localhost node packages/cli/src/index.ts push",
    "remove": "node packages/cli/src/index.ts remove",
    "remove:local": "APPLET_HOST_SUFFIX=.localhost node packages/cli/src/index.ts remove",
    "ship": "vp run deploy && vp run push --visibility public examples/preact-app && vp run push --visibility public examples/mailbox",
    "tail": "vpx wrangler tail applets-router",
    "templates": "node tools/templates.ts",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.1",
    "wrangler": "^4.137.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
